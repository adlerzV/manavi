generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String          @id @default(uuid())
  telegramId        BigInt          @unique
  firstName         String
  lastName          String?
  username          String?
  role              Role            @default(USER)
  isSubscribed      Boolean         @default(false)
  subscriptionEnd   DateTime?
  coinsBalance      Int             @default(0)
  contentPreference AgeRating       @default(NORMAL)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  donationsReceived Transaction[] @relation("Receiver")
  comments          Comment[]
  transactionsSent  Transaction[]   @relation("Payer")
  bookmarks         Bookmark[]
  readHistory       ReadHistory[]
  staffRoles        ComicStaff[]
  chapterStaffRoles ChapterStaff[]
  chapterUnlocks    ChapterUnlock[]
  publisherProfile  Publisher?

  @@index([role])
}

enum Role {
  USER
  LOCALIZATION_TEAM
  PUBLISHER
  ADMIN
}

model Publisher {
  id             String    @id @default(uuid())
  name           String
  legalEntity    String?
  contactEmail   String
  contractUserId String?   @unique
  contractUser   User?     @relation(fields: [contractUserId], references: [id])
  createdAt      DateTime  @default(now())

  licenses       License[]
}

enum LicenseStatus {
  PENDING
  ACTIVE
  EXPIRED
  TERMINATED
}

model License {
  id                String        @id @default(uuid())
  publisherId       String
  publisher         Publisher     @relation(fields: [publisherId], references: [id])

  territory         String[]
  royaltyPercentage Decimal       @db.Decimal(5, 2)
  status            LicenseStatus @default(PENDING)

  startDate         DateTime
  endDate           DateTime?
  terminatedAt      DateTime?
  contractReference String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  comics            Comic[]
  settlements       RoyaltySettlement[]

  @@index([publisherId])
  @@index([status])
}

model Comic {
  id            String        @id @default(uuid())
  title         String
  slug          String        @unique
  description   String
  coverImage    String
  bannerImage   String?
  dominantColor String?
  ageRating     AgeRating     @default(NORMAL)
  status        ComicStatus   @default(ONGOING)
  createdAt     DateTime      @default(now())

  licenseId     String
  license       License       @relation(fields: [licenseId], references: [id])

  chapters      Chapter[]
  staff         ComicStaff[]
  bookmarks     Bookmark[]
  transactions  Transaction[]
  genres        ComicGenre[]
  tags          ComicTag[]
  readHistory   ReadHistory[]

  @@index([licenseId])
}

enum AgeRating {
  NORMAL
  EIGHTEEN_PLUS
  NSFW
}

enum ComicStatus {
  ONGOING
  COMPLETED
  HIATUS
}

model Genre {
  id     String       @id @default(uuid())
  name   String       @unique
  slug   String       @unique
  comics ComicGenre[]
}

model ComicGenre {
  comicId String
  genreId String
  comic   Comic @relation(fields: [comicId], references: [id])
  genre   Genre @relation(fields: [genreId], references: [id])

  @@id([comicId, genreId])
}

model Tag {
  id     String     @id @default(uuid())
  name   String     @unique
  slug   String     @unique
  comics ComicTag[]
}

model ComicTag {
  comicId String
  tagId   String
  comic   Comic @relation(fields: [comicId], references: [id])
  tag     Tag   @relation(fields: [tagId], references: [id])

  @@id([comicId, tagId])
}

model ComicStaff {
  id        String    @id @default(uuid())
  comicId   String
  userId    String
  roleTitle StaffRole

  comic Comic @relation(fields: [comicId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([comicId, userId, roleTitle])
}

enum StaffRole {
  LOCALIZATION_SPECIALIST
  EDITOR
  CLEANER
}

model Chapter {
  id            String    @id @default(uuid())
  comicId       String
  chapterNumber Float
  title         String?
  pages         String[]
  isLocked      Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  comic    Comic           @relation(fields: [comicId], references: [id])
  comments Comment[]
  staff    ChapterStaff[]
  unlocks  ChapterUnlock[]

  @@index([comicId, chapterNumber])
}

model ChapterStaff {
  id        String    @id @default(uuid())
  chapterId String
  userId    String
  roleTitle StaffRole

  chapter Chapter @relation(fields: [chapterId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([chapterId, userId, roleTitle])
}

model ChapterUnlock {
  userId    String
  chapterId String
  expiresAt DateTime?

  user    User    @relation(fields: [userId], references: [id])
  chapter Chapter @relation(fields: [chapterId], references: [id])

  @@id([userId, chapterId])
}

model Comment {
  id        String   @id @default(uuid())
  chapterId String
  userId    String
  content   String
  isSpoiler Boolean  @default(false)
  createdAt DateTime @default(now())

  chapter Chapter @relation(fields: [chapterId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([chapterId, createdAt])
}

model Bookmark {
  userId    String
  comicId   String
  createdAt DateTime @default(now())
  user      User  @relation(fields: [userId], references: [id])
  comic     Comic @relation(fields: [comicId], references: [id])

  @@id([userId, comicId])
}

model ReadHistory {
  userId        String
  comicId       String
  lastChapterId String
  lastPage      Int      @default(1)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
  comic Comic @relation(fields: [comicId], references: [id])

  @@id([userId, comicId])
}

model Transaction {
  id       String            @id @default(uuid())
  type     TransactionType
  status   TransactionStatus @default(PENDING)
  amount   Decimal           @db.Decimal(12, 2)
  currency String            @default("IRT")

  payerId String
  payer   User   @relation("Payer", fields: [payerId], references: [id])

  receiverId String?
  receiver   User?   @relation("Receiver", fields: [receiverId], references: [id])
  message    String?

  comicId String?
  comic   Comic?  @relation(fields: [comicId], references: [id])

  gatewayAuthority String? @unique
  gatewayRefId     String?

  settlementId String?
  settlement   RoyaltySettlement? @relation(fields: [settlementId], references: [id])

  createdAt DateTime @default(now())

  @@index([comicId])
  @@index([type])
  @@index([settlementId])
  @@index([status])
  @@index([receiverId])
}

enum TransactionType {
  SUBSCRIPTION
  DONATION
  COIN_PURCHASE
  CHAPTER_UNLOCK
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
}

model RoyaltySettlement {
  id        String  @id @default(uuid())
  licenseId String
  license   License @relation(fields: [licenseId], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  grossRevenue          Decimal @db.Decimal(12, 2)
  publisherShare        Decimal @db.Decimal(12, 2)
  localizationTeamShare Decimal @db.Decimal(12, 2)

  status SettlementStatus @default(PENDING)
  paidAt DateTime?

  transactions Transaction[]
  createdAt    DateTime      @default(now())

  @@index([licenseId, periodStart])
}

enum SettlementStatus {
  PENDING
  PAID
  DISPUTED
}

model CreatorApplication {
  id           String                   @id @default(uuid())
  fullName     String
  contact      String
  portfolioUrl String?
  message      String
  status       CreatorApplicationStatus @default(NEW)
  createdAt    DateTime                 @default(now())
}

enum CreatorApplicationStatus {
  NEW
  REVIEWING
  ACCEPTED
  REJECTED
}